# Deepgram — Real-time Speech-to-Text
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq — LLM Translation Inference
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Azure Cognitive Services — Text-to-Speech
# Get your key at: https://portal.azure.com/
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_REGION=eastus

# Language Configuration
# Source language for Deepgram STT (BCP-47 format, e.g. en-US, es, fr, de)
SOURCE_LANGUAGE=en-US
# Target language for translation and TTS (e.g. hi, es, fr, de, ja, ko, zh)
TARGET_LANGUAGE=hi
